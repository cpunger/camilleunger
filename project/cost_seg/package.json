    "postinstall": "npm run setup:launcher"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}
