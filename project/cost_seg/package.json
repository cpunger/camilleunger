{
  "name": "cost-seg-analyzer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "setup:mac-launcher": "./scripts/setup-mac-launcher.sh",
